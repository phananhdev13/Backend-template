<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath />
  </parent>

  <groupId>com.acme</groupId>
  <artifactId>backend-template</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>backend-template</name>
  <description>Agent-native Spring Boot monorepo template: principles, annotations, structural tests.</description>

  <modules>
    <module>platform/bom</module>
    <module>libs/kernel</module>
    <module>libs/arch-test</module>
    <module>libs/web-support</module>
    <module>libs/persistence-support</module>
    <module>libs/messaging-support</module>
    <module>libs/observability-support</module>
    <module>libs/caching-support</module>
    <module>libs/scheduling-support</module>
    <module>libs/grpc-support</module>
    <module>libs/temporal-support</module>
    <module>libs/blob-storage-support</module>
    <module>services/order-service</module>
    <module>services/agent-factory</module>
  </modules>

  <properties>
    <!-- Single source of truth for the version of every module in this repo. -->
    <revision>0.1.0-SNAPSHOT</revision>

    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Ecosystem versions not managed by spring-boot-dependencies. -->
    <spring-modulith.version>2.1.1</spring-modulith.version>
    <!-- Pinned to what spring-modulith-core 2.1.1 depends on. Bumping this
         independently puts two ArchUnit versions on the test classpath. -->
    <archunit.version>1.4.2</archunit.version>
    <springdoc.version>3.1.0</springdoc.version>
    <jspecify.version>1.0.1</jspecify.version>
    <!-- The OpenTelemetry Java agent's own release, not the opentelemetry-api version
         spring-boot-dependencies already manages (1.62.0, via its opentelemetry-bom
         import). This module's release train versions the agent, the annotations
         and the instrumentation-bom together; the annotations artifact's own POM
         requests opentelemetry-api 1.65.0, which Maven's dependency management
         overrides down to the 1.62.0 Boot already pins - safe, because the
         OpenTelemetry API is additive-only across minor versions. See ADR-0019. -->
    <otel-instrumentation.version>2.31.1</otel-instrumentation.version>
    <!-- quartz.version is already managed by spring-boot-dependencies (2.5.2); ShedLock is not
         a Spring project and carries its own release train. -->
    <shedlock.version>7.9.0</shedlock.version>

    <!-- Build plugin versions. -->
    <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
    <spotless-maven-plugin.version>3.10.1</spotless-maven-plugin.version>
    <palantir-java-format.version>2.97.0</palantir-java-format.version>
    <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
    <checkstyle.version>14.0.0</checkstyle.version>
    <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <!-- protoc and protoc-gen-grpc-java are pinned to ${protobuf-java.version} and
         ${grpc-java.version} at each use site - both already managed by
         spring-boot-dependencies - never repinned here, so codegen and the gRPC runtime on the
         classpath never disagree on wire-format details. -->
    <protobuf-maven-plugin.version>5.1.8</protobuf-maven-plugin.version>

    <!-- Quality gates. Raise these as the codebase matures; never lower them silently. -->
    <jacoco.line.coverage.min>0.00</jacoco.line.coverage.min>

    <!-- Root of the shared build configuration, resolved from every module. -->
    <build.config.dir>${maven.multiModuleProjectDirectory}/build</build.config.dir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Modules of this repo. platform/bom re-publishes this same list for
           consumers outside the reactor; it cannot be imported here because it
           inherits from this pom. Keep the two lists in step - ArchUnit test
           PlatformBomCoversAllLibrariesTest fails the build if they drift. -->
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>kernel</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>arch-test</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>web-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>persistence-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>messaging-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>observability-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>caching-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>scheduling-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>grpc-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>temporal-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>com.acme</groupId>
        <artifactId>blob-storage-support</artifactId>
        <version>${revision}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- spring-boot-dependencies pins testcontainers.version but does not import
           the BOM, so the individual modules have no managed version without this. -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-common</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <!-- @WithSpan/@SpanAttribute: real spans only when the process runs under
           -javaagent:opentelemetry-javaagent.jar (ADR-0019); a no-op without it. -->
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-annotations</artifactId>
        <version>${otel-instrumentation.version}</version>
      </dependency>
      <!-- @SchedulerLock: managed here, not only inside scheduling-support's own pom, so a
           service that wants ShedLock (agent-factory's IdempotencyLedgerHousekeepingJob) can
           depend on it directly without repeating the version. See P-132. -->
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-spring</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
      <dependency>
        <groupId>net.javacrumbs.shedlock</groupId>
        <artifactId>shedlock-provider-jdbc-template</artifactId>
        <version>${shedlock.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Nullness contracts are part of every module's public API surface. -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
          <configuration>
            <java>
              <includes>
                <include>src/main/java/**/*.java</include>
                <include>src/test/java/**/*.java</include>
              </includes>
              <palantirJavaFormat>
                <version>${palantir-java-format.version}</version>
              </palantirJavaFormat>
              <removeUnusedImports />
              <formatAnnotations />
              <trimTrailingWhitespace />
              <endWithNewline />
            </java>
            <pom>
              <sortPom>
                <expandEmptyElements>false</expandEmptyElements>
                <spaceBeforeCloseEmptyElement>true</spaceBeforeCloseEmptyElement>
                <keepBlankLines>true</keepBlankLines>
                <nrOfIndentSpace>2</nrOfIndentSpace>
                <sortDependencies>none</sortDependencies>
                <sortPlugins>none</sortPlugins>
                <sortProperties>false</sortProperties>
                <sortModules>false</sortModules>
              </sortPom>
            </pom>
          </configuration>
          <executions>
            <execution>
              <id>spotless-check</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <version>${maven-checkstyle-plugin.version}</version>
          <configuration>
            <configLocation>${build.config.dir}/checkstyle/checkstyle.xml</configLocation>
            <suppressionsLocation>${build.config.dir}/checkstyle/suppressions.xml</suppressionsLocation>
            <!-- The plugin only auto-defines config_loc for configs it resolves from
                 its own classpath, not for a file path, so define it here. -->
            <propertyExpansion>config_loc=${build.config.dir}/checkstyle</propertyExpansion>
            <includeTestSourceDirectory>true</includeTestSourceDirectory>
            <consoleOutput>true</consoleOutput>
            <failOnViolation>true</failOnViolation>
            <violationSeverity>warning</violationSeverity>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>com.puppycrawl.tools</groupId>
              <artifactId>checkstyle</artifactId>
              <version>${checkstyle.version}</version>
            </dependency>
          </dependencies>
          <executions>
            <execution>
              <id>checkstyle-check</id>
              <goals>
                <goal>check</goal>
              </goals>
              <phase>validate</phase>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${spotbugs-maven-plugin.version}</version>
          <configuration>
            <effort>Max</effort>
            <threshold>Medium</threshold>
            <excludeFilterFile>${build.config.dir}/spotbugs/exclude.xml</excludeFilterFile>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ${revision} must be resolved before install/deploy, otherwise consumers
           receive a pom with an unresolvable version placeholder. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>${flatten-maven-plugin.version}</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <goals>
              <goal>flatten</goal>
            </goals>
            <phase>process-resources</phase>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <goals>
              <goal>clean</goal>
            </goals>
            <phase>clean</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-build-invariants</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <banDuplicatePomDependencyVersions />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- `mvn verify -Pfast` skips the static-analysis gates for a tight inner loop.
         CI never uses this profile. -->
    <profile>
      <id>fast</id>
      <properties>
        <spotless.check.skip>true</spotless.check.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <spotbugs.skip>true</spotbugs.skip>
      </properties>
    </profile>

    <!-- Deep static analysis. Slower; run in CI on pull requests, not on every local build. -->
    <profile>
      <id>deep-analysis</id>
      <build>
        <plugins>
          <!-- Two versions of the same library on one classpath is a production
               incident waiting for the right request to arrive. This is not in the
               default build because a single upstream release can turn it red
               without anything in this repo changing. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-dependency-convergence</id>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <phase>validate</phase>
                <configuration>
                  <rules>
                    <dependencyConvergence />
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>spotbugs-check</id>
                <goals>
                  <goal>check</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Test coverage measurement. Kept out of the default build so that a plain
         `mvn verify` stays fast. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>jacoco-prepare</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>jacoco-report</id>
                <goals>
                  <goal>report</goal>
                </goals>
                <phase>verify</phase>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
