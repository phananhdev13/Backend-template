<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.acme</groupId>
    <artifactId>backend-template</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>arch-test</artifactId>

  <name>arch-test</name>
  <description>Executable architecture. Every principle in docs/principles that can be checked
    mechanically has a rule here, and every rule quotes the principle it enforces in
    its failure message, so a red build tells you what to read.</description>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>kernel</artifactId>
    </dependency>
    <!-- compile scope on purpose: this module IS test tooling, consumed from the
         test classpath of other modules. -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
    <!-- Event contracts are declared twice - on the annotation, and in the checked-in JSON
         schema consumers in other repositories generate from. EventContractRules reads the
         second to hold it to the first, which needs a parser. Jackson 3, the version Boot 4.1
         manages, so this adds no new version to any service's test classpath. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
