<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.acme</groupId>
    <artifactId>backend-template</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>messaging-support</artifactId>

  <name>messaging-support</name>
  <description>The broker-neutral half of event-driven messaging. @EventContract states the
    delivery semantics a stream needs - ordering key, retention, compaction,
    delivery guarantee - and the binders in this module translate that statement
    into Kafka topic configuration or RabbitMQ stream arguments. Application code
    states intent; only this module knows the broker.</description>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- The starter, not the bare library. Boot 4.1 split Kafka's autoconfiguration into its own
         module (spring-boot-kafka: KafkaTemplate, ProducerFactory, ConsumerFactory, @KafkaListener
         processing). Depending on spring-kafka alone gives you the client classes with nothing
         wiring them - KafkaEventPublisher's KafkaTemplate constructor argument would have no bean
         to inject, and the application would fail to start. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-kafka</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- spring-boot-starter alone does not pull in Jackson 3 databind - JSON support is its own
         starter. JacksonJsonSerializer/JacksonJsonDeserializer need tools.jackson.databind.json
         on the compile classpath, not just at runtime. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-amqp</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- JdbcProcessedMessageStore only. Optional for the same reason as the broker
         clients: a service that consumes nothing needs no idempotency ledger, and a
         service that keeps its ledger elsewhere should not inherit a JDBC stack. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-rabbitmq</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
