<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.acme</groupId>
    <artifactId>backend-template</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>persistence-support</artifactId>

  <name>persistence-support</name>
  <description>Persistence conventions that survive contact with production: auditable base
    entities, optimistic locking, and Flyway migration layout.</description>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>kernel</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- The starter, not the bare library. Boot 4.1 split Flyway's autoconfiguration into its own
         module (spring-boot-flyway: FlywayAutoConfiguration, the bean that actually runs
         migrations against the DataSource on startup). Depending on flyway-core alone gives you
         the migration engine with nothing to invoke it - Hibernate's own schema validation then
         fails against tables that were never created, the same trap spring-kafka alone was for
         messaging-support. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Flyway 10+ moved database-specific support out of flyway-core; without this, Flyway
         refuses to run at all against Postgres ("Unsupported Database: PostgreSQL"), rather than
         degrading. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Test -->
    <!-- Boot 4.1 split @DataJpaTest into its own starter, transitively bringing
         spring-boot-starter-test (JUnit, AssertJ) and spring-boot-starter-jdbc-test
         (@AutoConfigureTestDatabase) with it - the same per-slice split
         spring-boot-starter-webmvc-test already made for MockMvc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Testcontainers 2.x renamed every module artifact from <module> to
         testcontainers-<module>. Examples found online still use the 1.x names
         and will not resolve. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
